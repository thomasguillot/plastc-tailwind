---
import Icon from '../Icon.astro';
import { lineHTML } from './invoice-lines';
import { INVOICE_INIT as S, INVOICE_NUMBER, PAYMENT_METHODS, TAX_PERCENT, TERMS, initials, invoiceTotals, money } from '../../data/home';

interface Props {
  theme: 'light' | 'dark';
  label: string;
}
const { theme, label } = Astro.props;
const p = theme === 'light' ? 'l' : 'd';
const { sub, tax, grand } = invoiceTotals(S.lines);
---
<div data-pane={theme} data-theme={theme} class="bg-housing text-ink rounded-[24px] p-3 sm:p-4"><p class="engraved px-2 pb-3">{label}</p><div class="mock flex bg-housing text-ink rounded-[20px] overflow-hidden border border-[color:var(--k-seam)]">
  <div class="flex-1 min-w-0 p-4 sm:p-5" data-composer={p}>
    <div class="flex items-start justify-between gap-3 pb-4"><div><p class="text-xl font-bold tracking-[-0.015em] leading-tight">New invoice</p><p class="font-mono text-[13px] text-ink-2 mt-1">{INVOICE_NUMBER}</p></div><button type="button" class="btn btn-quiet btn-icon btn-sm" aria-label="Reset invoice" data-close><Icon name="x" class="w-4 h-4" sw="2" /></button></div>
    <div><label class="label" for={`cu${p}`}>Bill to</label><div class="input-group"><span class="avatar !w-6 !h-6 !text-[11px] shrink-0" aria-hidden="true">{initials(S.to)}</span><input id={`cu${p}`} value={S.to} data-to></div><p class="hint-error" id={`cu${p}-err`} data-to-err hidden>Enter a customer to bill.</p><code class="annot">.input-group  .avatar</code></div>
    <div class="mt-4"><p class="label">Items</p><ul data-lines class="divide-y divide-[color:var(--k-seam)] border-y border-[color:var(--k-seam)]" set:html={S.lines.map((l, i) => lineHTML(p, i, l)).join('')}></ul><div class="mt-2 flex items-center justify-between gap-3"><button type="button" class="btn btn-quiet btn-sm" data-add-line>Add line</button></div><code class="annot">.key  .btn-quiet</code></div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 [&>*]:min-w-0"><div><p class="label" id={`pt${p}`}>Payment terms</p><div class="seg" role="group" aria-labelledby={`pt${p}`} data-terms>{TERMS.map((t, i) => <button type="button" aria-pressed={String(i === S.terms)}>{t}</button>)}</div><code class="annot">.seg</code></div>
      <div><label class="flex items-start gap-3 cursor-pointer"><input type="checkbox" role="switch" class="switch mt-0.5" checked={S.rem} data-rem><span><span class="block text-sm font-semibold">Send reminders</span><span class="block text-[13px] text-ink-2">Reminds the customer before and after the due date.</span></span></label><code class="annot">.switch</code></div></div>
    <div class="mt-4"><p class="label" id={`pm${p}`}>How they'll pay</p><div class="grid gap-3 sm:grid-cols-2" role="radiogroup" aria-labelledby={`pm${p}`}>{PAYMENT_METHODS.map(({ label: method, hint }, i) => <label class="choice-card"><input type="radio" name={`pay${p}`} data-pay class="radio mt-0.5" checked={i === S.pay}><span class="flex-1"><span class="block text-sm font-bold">{method}</span><span class="block text-[13px] text-ink-2 mt-0.5">{hint}</span></span></label>)}</div><code class="annot">.choice-card  .radio</code></div>
    <div class="mt-4"><label class="label" for={`nt${p}`}>Note to customer</label><textarea id={`nt${p}`} data-note class="field field-area" rows="2" placeholder="Add a thank-you or a payment detail."></textarea><code class="annot">.field-area</code></div>
    <dl class="lcd px-4 py-3 mt-4 grid gap-1.5" aria-label="Invoice totals"><div class="flex justify-between gap-3 text-[13px]"><dt class="text-lcd-dim">Subtotal</dt><dd data-sub>{money.format(sub)}</dd></div><div class="flex justify-between gap-3 text-[13px]"><dt class="text-lcd-dim">Tax ({TAX_PERCENT}%)</dt><dd data-tax>{money.format(tax)}</dd></div><div class="flex justify-between items-baseline gap-3 pt-2 border-t border-[color:var(--k-seam)]"><dt class="text-[11px] tracking-[0.12em] uppercase text-lcd-dim">Total</dt><dd class="text-[26px] font-medium leading-none" data-grand>{money.format(grand)}</dd></div></dl><code class="annot">.lcd</code>
    <div class="flex flex-wrap items-center justify-end gap-3 mt-4"><button type="button" class="btn btn-quiet" data-toast={`Draft ${INVOICE_NUMBER} saved`}>Save draft</button><button type="button" class="btn btn-signal" data-send data-toast={`Invoice ${INVOICE_NUMBER} sent to ${S.to}`}>Send invoice</button></div><code class="annot text-right">.btn-signal</code>
  </div>
</div></div>
