---
import Icon from '../Icon.astro';
import { CSS_KB, CSS_ON_GITHUB, IMPORT_LINE, VERSION } from '../../data/site';
const FONT_LINK = '<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=Geist+Mono:wght@400..600&display=swap" rel="stylesheet">';
---
<section id="install" class="max-w-[1240px] mx-auto px-4 md:px-8 py-16 md:py-24" aria-labelledby="ins-h">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] items-start [&>*]:min-w-0">
    <div>
      <h2 id="ins-h" class="display text-[40px] md:text-[56px]">Add it to your project</h2>
      <p class="text-ink-2 text-lg max-w-[44ch] mt-5">Plastc isn't on npm. It's one CSS file you put next to your Tailwind v4 entry stylesheet.</p>
      <div class="flex flex-wrap gap-3 mt-8"><a class="btn btn-lg" href="plastc.css" download><Icon name="down" />Download plastc.css</a><button type="button" class="btn btn-lg" data-copy={IMPORT_LINE}><Icon name="copy" />Copy the import</button></div>
      <p class="text-sm text-ink-2 mt-4 tabular-nums">v{VERSION} · {CSS_KB} KB · MIT-Licensed</p>
    </div>
    <ol class="grid grid-cols-1 gap-6 list-none p-0 m-0 [counter-reset:step]">
      <li class="grid grid-cols-[auto_1fr] gap-x-4 items-start [counter-increment:step] before:content-[counter(step)] before:lcd before:grid before:place-items-center before:size-9 before:text-[16px] before:font-medium before:tabular-nums"><div class="min-w-0"><p class="font-bold mb-2">Copy <code class="font-mono text-[14px]">plastc.css</code> into your project</p><p class="text-sm text-ink-2">Or copy <a class="text-ink underline" href={CSS_ON_GITHUB}><code class="font-mono">src/plastc.css</code></a> from GitHub. It holds the tokens, depth recipes and every component class.</p></div></li>
      <li class="grid grid-cols-[auto_1fr] gap-x-4 items-start [counter-increment:step] before:content-[counter(step)] before:lcd before:grid before:place-items-center before:size-9 before:text-[16px] before:font-medium before:tabular-nums"><div class="min-w-0"><p class="font-bold mb-2">Import it after Tailwind</p><pre class="code min-w-0">{IMPORT_LINE}</pre></div></li>
      <li class="grid grid-cols-[auto_1fr] gap-x-4 items-start [counter-increment:step] before:content-[counter(step)] before:lcd before:grid before:place-items-center before:size-9 before:text-[16px] before:font-medium before:tabular-nums"><div class="min-w-0"><p class="font-bold mb-2">Load Geist and Geist Mono</p><p class="text-sm text-ink-2 mb-2">Plastc is set in Geist. Without it, text falls back to your system fonts.</p><pre class="code min-w-0">{FONT_LINK}</pre></div></li>
      <li class="grid grid-cols-[auto_1fr] gap-x-4 items-start [counter-increment:step] before:content-[counter(step)] before:lcd before:grid before:place-items-center before:size-9 before:text-[16px] before:font-medium before:tabular-nums"><div class="min-w-0"><p class="font-bold mb-2">Pick a theme</p><p class="text-sm text-ink-2">Light is the default. Add <code class="font-mono">data-theme="dark"</code> to <code class="font-mono">&lt;html&gt;</code>, or to any section, for dark.</p></div></li>
    </ol>
  </div>
</section>
