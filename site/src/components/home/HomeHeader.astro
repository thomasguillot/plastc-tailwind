---
import Icon from '../Icon.astro';
import Wordmark from '../Wordmark.astro';
import { GITHUB_SVG } from '../../lib/icons';
import { REPO } from '../../data/site';
---
<header class="max-w-[1240px] mx-auto px-4 md:px-8 pt-6 pb-2 md:pb-4 flex flex-wrap items-center gap-x-6 gap-y-3">
  <Wordmark href="#top" root="" />
  <nav class="order-3 md:order-none w-full md:w-auto flex flex-wrap gap-1 -mx-1 md:mx-0 md:ml-4" aria-label="Sections"><a class="btn btn-quiet btn-sm" href="/components/">Components</a><a class="btn btn-quiet btn-sm" href="screens/dashboard.html" data-open-screen="dashboard">Screens</a><a class="btn btn-quiet btn-sm" href="#install">Docs and install</a></nav>
  <a class="btn btn-quiet btn-sm ml-auto" href={REPO}><Fragment set:html={GITHUB_SVG} />GitHub</a>
  <div class="seg" role="group" aria-label="Theme"><button type="button" class="!px-3" data-set-theme="light" aria-pressed="true" aria-label="Light"><Icon name="sun" class="w-4 h-4" /></button><button type="button" class="!px-3" data-set-theme="dark" aria-pressed="false" aria-label="Dark"><Icon name="moon" class="w-4 h-4" /></button></div>
</header>
