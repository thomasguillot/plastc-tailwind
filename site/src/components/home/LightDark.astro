---
import InvoiceComposer from './InvoiceComposer.astro';
import { DEPTHS, TINTS } from '../../data/home';

const keyClass = 'key text-[13px] !aspect-auto h-12 !rounded-2xl';
---
<section id="housings" class="max-w-[1240px] mx-auto px-4 md:px-8 py-16 md:py-24" aria-labelledby="hou-h">
  <h2 id="hou-h" class="display text-[40px] md:text-[56px] max-w-[16ch]">Light and dark</h2>
  <p class="text-ink-2 text-lg max-w-[56ch] mt-5">Set the depth and the LCD tint here. Both panes follow, and so does the rest of the page.</p>
  <div class="raised rounded-[24px] p-5 sm:p-6 mt-8 grid gap-x-8 gap-y-7 sm:grid-cols-2" role="group" aria-label="Depth and LCD tint">
    <div class="grid gap-3 content-start"><p class="engraved" id="c-depth">Depth</p><div class="grid grid-cols-3 gap-3" role="group" aria-labelledby="c-depth">{DEPTHS.map(({ value, label }) => <button type="button" class={keyClass} data-set-depth={value} aria-pressed={String(value === '1')}>{label}</button>)}</div></div>
    <div class="grid gap-3 content-start"><p class="engraved" id="c-tint">LCD tint</p><div class="grid grid-cols-3 gap-3" role="group" aria-labelledby="c-tint" data-tint>{TINTS.map(({ name, label, chip }, i) => <button type="button" class={`${keyClass} inline-flex items-center justify-center !gap-2.5`} data-tint-set={name} aria-pressed={String(i === 0)}><span class="inline-grid place-items-center h-6 px-1.5 rounded-md font-mono text-[12px] font-semibold tabular-nums shadow-[inset_0_1px_2px_rgb(0_0_0/.25)]" style={`background:${chip.bg};color:${chip.fg}`} aria-hidden="true">88</span>{label}</button>)}</div></div>
    <div class="sm:col-span-2 flex flex-wrap items-center justify-between gap-4 pt-5 border-t border-[color:var(--k-seam)]"><label class="flex items-center gap-4 cursor-pointer"><span class="engraved">Show class names</span><input type="checkbox" role="switch" class="switch" id="labels-switch"></label><button type="button" class={`${keyClass} px-6`} data-reset-all>Reset all</button></div>
  </div>
  <div class="seg mt-8 md:hidden" role="group" aria-label="Show pane" data-pane-seg><button type="button" aria-pressed="true" data-pane-set="light">Light</button><button type="button" aria-pressed="false" data-pane-set="dark">Dark</button></div>
  <div class="grid gap-6 lg:grid-cols-2 mt-4 md:mt-8 [&>*]:min-w-0" data-panes data-show="light">
    <InvoiceComposer theme="light" label="Light" />
    <InvoiceComposer theme="dark" label="Dark" />
  </div>
</section>

<style is:global>
  .annot{display:block;height:0;margin-top:0;overflow:hidden;opacity:0;visibility:hidden;font:500 11px/1.4 var(--font-mono);color:var(--k-ink-2);interpolate-size:allow-keywords;transition:height 240ms var(--ease-out),margin-top 240ms var(--ease-out),opacity 180ms var(--ease-out),visibility 0s 240ms}
  #housings[data-labels] .annot{height:auto;margin-top:6px;opacity:1;visibility:visible;transition:height 240ms var(--ease-out),margin-top 240ms var(--ease-out),opacity 180ms var(--ease-out),visibility 0s}
  @media (prefers-reduced-motion:reduce){.annot,#housings[data-labels] .annot{transition:opacity 180ms var(--ease-out),visibility 0s}}
  @media (max-width:767.98px){[data-panes][data-show="light"]>[data-pane="dark"],[data-panes][data-show="dark"]>[data-pane="light"]{display:none}}
</style>

<script>
  import { lineHTML } from './invoice-lines';
  import { apca, wcag } from './contrast';
  import { INVOICE_INIT, INVOICE_NUMBER, LINE_PRESETS, MAX_LINES, QTY_MAX, QTY_MIN, TINTS, initials, invoiceTotals, money, type InvoiceState, type TintName } from '../../data/home';

  type Plastc = { toast?: (msg: string, undo?: (() => void) | null) => void; quietRetheme?: () => void };
  const PL: Plastc = (window as unknown as { plastc?: Plastc }).plastc || {};
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll<T>(s)];
  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s)!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(0.23, 1, 0.32, 1)';
  const copy = (s: InvoiceState): InvoiceState => JSON.parse(JSON.stringify(s));

  const comps = $$('[data-composer]');
  let resetComposer = () => {};
  if (comps.length) {
    let S = copy(INVOICE_INIT);
    const tick = (el: HTMLElement, t: string) => {
      if (el.textContent === t) return;
      el.textContent = t;
      if (!el.animate || el.getAnimations().some((a) => a.playState === 'running')) return;
      el.animate(reduce ? [{ opacity: 0 }, { opacity: 1 }] : [{ opacity: 0, filter: 'blur(2px)', translate: '0 4px' }, { opacity: 1, filter: 'blur(0)', translate: '0 0' }], { duration: 180, easing: EASE });
    };
    const val = (el: HTMLInputElement | HTMLTextAreaElement | null, v: string) => { if (el && el.value !== v) el.value = v; };
    const render = (full: boolean) => {
      const { sub, tax, grand } = invoiceTotals(S.lines);
      comps.forEach((c) => {
        if (full) $('[data-lines]', c).innerHTML = S.lines.map((l, i) => lineHTML(c.dataset.composer!, i, l)).join('');
        $$('[data-line]', c).forEach((li, i) => {
          const l = S.lines[i];
          const [dec, inc] = $$<HTMLButtonElement>('[data-step]', li);
          val($<HTMLInputElement>('[data-desc]', li), l.d);
          $('[data-qty]', li).textContent = String(l.q);
          dec.disabled = l.q <= QTY_MIN;
          inc.disabled = l.q >= QTY_MAX;
          dec.setAttribute('aria-label', `Decrease quantity for ${l.d}`);
          inc.setAttribute('aria-label', `Increase quantity for ${l.d}`);
          tick($('[data-total]', li), money.format(l.p * l.q));
        });
        const to = $<HTMLInputElement>('[data-to]', c);
        const err = $('[data-to-err]', c);
        val(to, S.to);
        val($<HTMLTextAreaElement>('[data-note]', c), S.note);
        err.hidden = !S.err;
        const avatar = $('.avatar', to.parentElement!);
        const ini = initials(S.to);
        avatar.textContent = ini;
        avatar.style.display = ini ? '' : 'none';
        if (S.err) { to.setAttribute('aria-invalid', 'true'); to.setAttribute('aria-describedby', err.id); }
        else { to.removeAttribute('aria-invalid'); to.removeAttribute('aria-describedby'); }
        $$('[data-terms] > button', c).forEach((b, i) => b.setAttribute('aria-pressed', String(i === S.terms)));
        $<HTMLInputElement>('[data-rem]', c).checked = S.rem;
        $$<HTMLInputElement>('[data-pay]', c).forEach((r, i) => (r.checked = i === S.pay));
        $<HTMLButtonElement>('[data-add-line]', c).disabled = S.lines.length >= MAX_LINES;
        $('[data-send]', c).dataset.toast = `Invoice ${INVOICE_NUMBER} sent to ${S.to.trim()}`;
        tick($('[data-sub]', c), money.format(sub));
        tick($('[data-tax]', c), money.format(tax));
        tick($('[data-grand]', c), money.format(grand));
      });
    };
    resetComposer = () => { S = copy(INVOICE_INIT); render(true); };
    comps.forEach((c) => {
      c.addEventListener('click', (e) => {
        const target = e.target as Element;
        const b = target.closest<HTMLButtonElement>('[data-step]');
        if (b) {
          const li = b.closest<HTMLElement>('[data-line]')!;
          const l = S.lines[+li.dataset.line!];
          l.q = Math.max(QTY_MIN, Math.min(QTY_MAX, l.q + +b.dataset.step!));
          render(false);
          if (b.disabled) li.querySelector<HTMLButtonElement>('[data-step]:not(:disabled)')?.focus();
          return;
        }
        const t = target.closest<HTMLElement>('[data-terms] > button');
        if (t) { S.terms = $$('[data-terms] > button', c).indexOf(t); render(false); return; }
        if (target.closest('[data-add-line]')) {
          if (S.lines.length >= MAX_LINES) return;
          const [d, p] = LINE_PRESETS[(S.lines.length - INVOICE_INIT.lines.length) % LINE_PRESETS.length];
          S.lines.push({ d, p, q: 1 });
          render(true);
          const inputs = $$('[data-desc]', c);
          inputs[inputs.length - 1].focus();
          return;
        }
        if (target.closest('[data-send]') && !S.to.trim()) {
          e.stopPropagation();
          S.err = true;
          render(false);
          $('[data-to]', c).focus();
          return;
        }
        const x = target.closest<HTMLElement>('[data-close]');
        if (x) {
          const prev = JSON.stringify(S);
          const changed = prev !== JSON.stringify(INVOICE_INIT);
          resetComposer();
          PL.toast?.(`Invoice ${INVOICE_NUMBER} reset`, changed ? () => { S = JSON.parse(prev); render(true); x.focus(); } : null);
        }
      });
      c.addEventListener('input', (e) => {
        const t = e.target as HTMLInputElement;
        if (t.matches('[data-to]')) { S.to = t.value; if (S.err && S.to.trim()) S.err = false; }
        else if (t.matches('[data-desc]')) S.lines[+t.closest<HTMLElement>('[data-line]')!.dataset.line!].d = t.value;
        else if (t.matches('[data-note]')) S.note = t.value;
        else return;
        render(false);
      });
      c.addEventListener('change', (e) => {
        const t = e.target as HTMLInputElement;
        if (t.matches('[data-rem]')) S.rem = t.checked;
        else if (t.matches('[data-pay]')) S.pay = $$('[data-pay]', c).indexOf(t);
        else return;
        render(false);
      });
    });
    render(true);
  }

  const panes = document.querySelector<HTMLElement>('[data-panes]');
  const paneSeg = document.querySelector<HTMLElement>('[data-pane-seg]');
  const showPane = (n: string) => {
    if (!panes) return;
    panes.dataset.show = n;
    if (paneSeg) $$('button', paneSeg).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.paneSet === n)));
  };
  paneSeg?.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-pane-set]');
    if (b) showPane(b.dataset.paneSet!);
  });

  const tints = Object.fromEntries(TINTS.map((t) => [t.name, t])) as Record<TintName, (typeof TINTS)[number]>;
  const LCD_VARS = ['--k-lcd', '--k-lcd-ink', '--k-lcd-dim'];
  const lcdFigures = (name: TintName) =>
    (['light', 'dark'] as const).forEach((th) => {
      const [bg, ink] = tints[name][th];
      $$(`[data-lcd-w="${th}"]`).forEach((el) => (el.textContent = `${wcag(ink, bg).toFixed(1)}:1`));
      $$(`[data-lcd-lc="${th}"]`).forEach((el) => (el.textContent = String(Math.round(Math.abs(apca(ink, bg))))));
    });
  const themed = $$('[data-theme]');
  let current: TintName = 'green';
  const tint = (name: TintName) => {
    current = name;
    PL.quietRetheme?.();
    themed.forEach((el) => {
      const theme = el.dataset.theme === 'dark' ? 'dark' : 'light';
      LCD_VARS.forEach((v, i) => (name !== 'green' ? el.style.setProperty(v, tints[name][theme][i]) : el.style.removeProperty(v)));
    });
    $$('[data-tint-set]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tintSet === name)));
    lcdFigures(name);
  };
  $$('[data-tint-set]').forEach((b) => b.addEventListener('click', () => tint(b.dataset.tintSet as TintName)));
  new MutationObserver(() => tint(current)).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  const labels = document.getElementById('labels-switch') as HTMLInputElement | null;
  const section = document.getElementById('housings');
  if (labels && section) labels.addEventListener('change', () => section.toggleAttribute('data-labels', labels.checked));
  document.querySelector('[data-reset-all]')?.addEventListener('click', () => {
    const normal = document.querySelector<HTMLElement>('[data-set-depth="1"]');
    if (normal && normal.getAttribute('aria-pressed') !== 'true') normal.click();
    tint('green');
    if (labels?.checked) { labels.checked = false; section?.removeAttribute('data-labels'); }
    resetComposer();
    showPane('light');
  });
</script>
