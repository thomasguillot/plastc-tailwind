---
import Icon from '../Icon.astro';
import { iconSvg } from '../../lib/icons';

const nav = [
  { label: 'Dashboard', current: true, svg: iconSvg('<path d="M3 10.5 12 4l9 6.5V20a1 1 0 0 1-1 1h-5.5v-6h-5v6H4a1 1 0 0 1-1-1z"/>') },
  { label: 'Invoices', svg: iconSvg('<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>') },
  { label: 'Customers', svg: iconSvg('<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6.5 6.5 0 0 1 3.5 6"/>') },
  { label: 'Reports', svg: iconSvg('<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>') },
];
const stats = [
  ['Revenue', '$44,900'],
  ['Outstanding', '$15,447'],
  ['Days to pay', '18.2'],
];
const invoices = [
  ['INV-0193', 'Halden Studio', 'lamp-ok', 'Paid', '$4,820.00'],
  ['INV-0192', 'Ortiz & Lane', 'lamp-ok', 'Paid', '$1,240.50'],
  ['INV-0191', 'Northwind Co-op', 'lamp-danger', 'Overdue', '$9,300.00'],
];
const months = ['Jun', 'Jul', 'Aug', 'Sep', 'Oct'];
const line = 'M30.0 37.6 C40.0 36.9 70.0 35.9 90.0 33.3 C110.0 30.7 130.0 22.5 150.0 22.0 C170.0 21.5 190.0 30.1 210.0 30.5 C230.0 30.9 260.0 25.2 270.0 24.1';
const { piece } = Astro.props as { piece?: string };
const frame = 'bg-housing text-ink rounded-[20px] border border-[color:var(--k-seam)]';
---
{piece === '1' && <div class={`${frame} flex overflow-hidden`} aria-hidden="true" inert><aside class="flex flex-col gap-4 w-[168px] shrink-0 p-4 border-r border-[color:var(--k-seam)]"><p class="font-extrabold tracking-[-0.02em] text-[16px] px-2">Plastc Invoicing</p><nav class="flex flex-col gap-1">{nav.slice(1, 3).map(({ label, svg }) => <a class="nav-item" href="#" tabindex="-1"><Fragment set:html={svg} /><span>{label}</span></a>)}</nav></aside><div class="flex-1 min-w-0"></div></div>}
{piece === '2' && <div class={`${frame} p-4`} aria-hidden="true" inert><div class="panel !p-4"><p class="font-bold text-sm mb-3">Revenue</p><div class="relative"><svg class="chart" viewBox="0 0 300 64"><line class="chart-grid" x1="0" x2="300" y1="16.0" y2="16.0"/><line class="chart-grid" x1="0" x2="300" y1="35.2" y2="35.2"/><line class="chart-grid" x1="0" x2="300" y1="63.0" y2="63.0"/><defs><linearGradient id="lg2" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--k-ink)" stop-opacity=".14"/><stop offset="1" stop-color="var(--k-ink)" stop-opacity="0"/></linearGradient></defs><path d={`${line} L270.0 64 L30.0 64 Z`} fill="url(#lg2)" stroke="none"/><path d={line} fill="none" stroke="var(--k-ink)" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/><circle cx="270.0" cy="24.1" r="5.5" fill="var(--k-ink)" stroke="var(--k-housing)" stroke-width="2"/></svg><span class="absolute translate-x-[-50%] translate-y-[-190%] text-[12px] font-bold leading-none text-ink whitespace-nowrap tabular-nums" style="left:90.0%;top:37.7%">$45k</span></div><div class="bar-chart-axis">{months.map((m, i) => <span data-current={i === months.length - 1 ? '' : undefined}>{m}</span>)}</div></div></div>}
{piece === '3' && <div class={`${frame} p-4 flex flex-wrap items-center justify-between gap-3`} aria-hidden="true" inert><div class="flex gap-2"><button type="button" class="btn btn-sm" tabindex="-1">Export</button><button type="button" class="btn btn-sm btn-signal" tabindex="-1">New invoice</button></div><div class="seg"><button type="button" aria-pressed="true" tabindex="-1">Month</button><button type="button" aria-pressed="false" tabindex="-1">Quarter</button></div></div>}
{piece === '4' && <div class={`${frame} p-4 flex flex-col gap-3`} aria-hidden="true" inert><div class="input-group"><Icon name="search" /><input placeholder="Search" tabindex="-1"><span class="kbd" data-kbd-mod>Ctrl K</span></div><nav class="flex flex-col w-[136px]">{nav.slice(0, 1).map(({ label, svg }) => <a class="nav-item" href="#" aria-current="page" tabindex="-1"><Fragment set:html={svg} /><span>{label}</span></a>)}</nav></div>}
{piece === '5' && <div class={`${frame} p-4 flex flex-col gap-3`} aria-hidden="true" inert><dl class="lcd px-4 py-3 grid grid-cols-2 gap-3">{stats.map(([label, value]) => <div class="stat"><dt>{label}</dt><dd class="stat-value !text-[22px]">{value}</dd></div>)}</dl><div><div class="flex flex-wrap justify-between gap-x-3 text-[13px] mb-2"><span class="font-semibold">Paid this quarter</span><span class="text-ink-2 tabular-nums">$39,556 of $63,800</span></div><div class="meter"><span style="--v:62%"></span></div></div></div>}
{piece === '6' && <div class={`${frame} p-4 flex flex-col items-end gap-3`} aria-hidden="true" inert><div class="menu w-[170px] !min-w-0"><button type="button" tabindex="-1">Export as CSV</button><button type="button" tabindex="-1">Export as PDF</button></div><div class="toast"><span>Invoice sent</span><span class="lcd-action">Undo</span></div></div>}
{!piece && <div class="mock relative flex bg-housing text-ink rounded-[20px] border border-[color:var(--k-seam)] [--chart-h:84px] md:h-full" data-layer="1" aria-hidden="true" inert>
  <aside class="d-side flex flex-col gap-4 w-[168px] shrink-0 p-4 border-r border-[color:var(--k-seam)]" data-layer="1"><p class="font-extrabold tracking-[-0.02em] text-[16px] px-2">Plastc Invoicing</p><nav class="flex flex-col gap-1">{nav.map(({ label, current, svg }) => <a class="nav-item" href="#" aria-current={current ? 'page' : undefined} tabindex="-1" data-layer={current ? '4' : undefined}><Fragment set:html={svg} /><span class="d-nl">{label}</span></a>)}</nav></aside>
  <div class="flex-1 min-w-0 p-4 flex flex-col gap-3">
    <div class="flex flex-wrap items-center gap-2"><label class="input-group d-search flex-1 min-w-[120px]" data-layer="4"><Icon name="search" /><span class="sr-only">Search</span><input placeholder="Search" tabindex="-1"><span class="kbd" data-kbd-mod aria-hidden="true">Ctrl K</span></label><div class="relative flex gap-2"><button type="button" class="btn btn-sm" tabindex="-1" data-layer="3">Export</button><button type="button" class="btn btn-sm btn-signal" tabindex="-1" data-layer="3">New invoice</button><div class="menu !absolute top-full right-0 mt-2 w-[170px] !min-w-0 z-10" data-layer="6"><button type="button" tabindex="-1">Export as CSV</button><button type="button" tabindex="-1">Export as PDF</button></div></div></div>
    <dl class="lcd px-4 py-3 grid grid-cols-3 gap-3" data-layer="5">{stats.map(([label, value]) => <div class="stat"><dt>{label}</dt><dd class="stat-value !text-[22px]">{value}</dd></div>)}</dl>
    <div><div class="flex flex-wrap justify-between gap-x-3 text-[13px] mb-2"><span class="font-semibold">Paid this quarter</span><span class="text-ink-2 tabular-nums">$39,556 of $63,800</span></div><div class="meter" data-layer="5"><span style="--v:62%"></span></div></div>
    <div class="panel d-chart !p-4" data-layer="2">
      <div class="flex items-center justify-between gap-3 mb-3"><p class="font-bold text-sm">Revenue</p><div class="seg" role="group" aria-label="Chart range" data-layer="3"><button type="button" aria-pressed="true" tabindex="-1">Month</button><button type="button" aria-pressed="false" tabindex="-1">Quarter</button></div></div>
      <div data-layer="2"><div class="relative" role="img" aria-label="Revenue by month, June to October 2026: $26k, $32k, $48k, $36k, $45k. October is $45k, August is the peak at $48k."><svg class="chart" viewBox="0 0 300 64" aria-hidden="true"><line class="chart-grid" x1="0" x2="300" y1="16.0" y2="16.0"/><line class="chart-grid" x1="0" x2="300" y1="35.2" y2="35.2"/><line class="chart-grid" x1="0" x2="300" y1="63.0" y2="63.0"/><defs><linearGradient id="lg1" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--k-ink)" stop-opacity=".14"/><stop offset="1" stop-color="var(--k-ink)" stop-opacity="0"/></linearGradient></defs><path d={`${line} L270.0 64 L30.0 64 Z`} fill="url(#lg1)" stroke="none"/><path d={line} fill="none" stroke="var(--k-ink)" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/><circle cx="270.0" cy="24.1" r="5.5" fill="var(--k-ink)" stroke="var(--k-housing)" stroke-width="2"/></svg><span class="absolute translate-x-[-50%] translate-y-[-190%] text-[12px] font-bold leading-none text-ink whitespace-nowrap tabular-nums" style="left:90.0%;top:37.7%">$45k</span></div><div class="bar-chart-axis" aria-hidden="true">{months.map((m, i) => <span data-current={i === months.length - 1 ? '' : undefined}>{m}</span>)}</div></div>
    </div>
    <div class="panel !p-0 flex-1" data-layer="2"><div class="flex items-center justify-between gap-3 px-4 pt-3 pb-1"><p class="font-bold text-sm">Recent invoices</p></div><div class="px-2 pb-2" data-layer="2"><table class="ktable"><thead><tr><th>Invoice</th><th class="d-cust">Customer</th><th>Status</th><th class="num">Amount</th></tr></thead><tbody>{invoices.map(([id, customer, lamp, status, amount]) => <tr><td class="font-semibold">{id}</td><td class="d-cust">{customer}</td><td><span class={`badge ${lamp}`}>{status}</span></td><td class="num font-semibold">{amount}</td></tr>)}</tbody></table></div></div>
    <div class="toast !absolute bottom-4 right-4 z-10" data-layer="6"><span>Invoice sent</span><span class="lcd-action">Undo</span></div>
  </div>
</div>}
