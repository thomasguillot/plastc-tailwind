---
interface Props {
  label: string;
  help: string;
}
const { label, help } = Astro.props;
---
<div class="grid gap-4 md:grid-cols-[260px_1fr] py-6 border-b border-[color:var(--k-seam)] shadow-[0_1px_0_rgb(var(--k-hl)/calc(.5*var(--k-hl-a)))] last:border-0 last:shadow-none">
  <div><p class="text-sm font-bold">{label}</p><p class="text-sm text-ink-2 mt-1">{help}</p></div><div class="max-w-[560px] min-w-0"><slot /></div></div>
