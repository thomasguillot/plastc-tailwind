---
import Icon from '../Icon.astro';

interface Props {
  id: string;
}
const { id } = Astro.props;
---
<section class="max-w-[1200px] mx-auto px-4 md:px-8 py-14 md:py-20" aria-labelledby={`${id}-h`}>
  <div class="panel !px-6 !py-8 md:!px-10 md:!py-10 grid gap-6 md:grid-cols-[1fr_minmax(0,420px)] items-center">
    <div><h2 id={`${id}-h`} class="text-[26px] md:text-[30px] font-bold tracking-[-0.015em] text-balance">Get new posts by email</h2><p class="text-ink-2 mt-2 max-w-[44ch]">One email when a post goes up, usually twice a month. Unsubscribe from any of them.</p></div>
    <form class="min-w-0" data-subscribe novalidate>
      <label class="label" for={`${id}-email`}>Email</label>
      <div class="input-group"><Icon name="mail" /><input id={`${id}-email`} type="email" autocomplete="email" placeholder="you@studio.com" required aria-describedby={`${id}-hint`}><button class="btn btn-signal">Subscribe</button></div>
      <p class="hint" id={`${id}-hint`} data-subscribe-hint>We only use it to send the blog.</p>
    </form>
  </div>
</section>
