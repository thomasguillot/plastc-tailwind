---
interface Props {
  name: string;
  classes: string;
  rule: string;
}
const { name, classes, rule } = Astro.props;
---
<div class="flex flex-col gap-4">
  <div class="h-40 grid place-items-center rounded-[20px] px-4 seam"><slot /></div>
  <div><p class="font-bold">{name} <code class="font-mono text-xs text-ink-2 ml-1">{classes}</code></p><p class="text-sm text-ink-2 mt-1 max-w-[36ch]">{rule}</p></div>
</div>
