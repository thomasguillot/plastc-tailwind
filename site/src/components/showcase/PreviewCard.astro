---
import Icon from '../Icon.astro';

interface Props {
  screen: string;
  title: string;
}
const { screen, title } = Astro.props;
---
<a href={`screens/${screen}.html`} class="group block no-underline text-ink" data-open-screen={screen}>
  <div class="recessed rounded-[18px] p-2"><div class="relative overflow-hidden rounded-xl aspect-[16/10] bg-housing"><iframe src={`screens/${screen}.html`} title={`${title} preview`} tabindex="-1" aria-hidden="true" class="absolute top-0 left-0 w-[1440px] h-[900px] origin-top-left scale-[var(--s)] pointer-events-none" style="--s:.25"></iframe></div></div>
  <p class="flex items-center justify-between font-bold mt-3">{title}<span class="text-ink-2 transition-transform duration-200 ease-out group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0"><Icon name="right" class="w-4 h-4" /></span></p>
</a>
