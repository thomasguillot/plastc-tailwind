---
import Icon from '../../Icon.astro';
---
<div class="empty seam rounded-[20px] !py-10">
  <div class="lcd readout"><span class="readout-value">0</span><span class="readout-unit">Customers</span></div>
  <h4>No customers yet</h4>
  <p>Customers appear here after you send their first invoice. You can also add one now.</p>
  <div class="empty-actions"><button class="btn btn-sm" data-toast="Customer form is not part of this demo"><Icon name="plus" sw="2.2" />Add customer</button><button class="btn btn-sm btn-quiet" data-toast="Import is not part of this demo"><Icon name="down" />Import CSV</button></div>
</div>
