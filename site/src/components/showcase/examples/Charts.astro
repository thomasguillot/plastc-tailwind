---
import BarChart from '../../charts/BarChart.astro';
import StatusDonut from '../../charts/StatusDonut.astro';
import StatusList from '../../charts/StatusList.astro';
import Sparkline from '../../charts/Sparkline.astro';
import { REV } from '../../../data/app';
---
<div class="grid gap-x-10 gap-y-8 md:grid-cols-[1.5fr_1fr_1fr] items-start">
  <figure><figcaption><span class="block font-bold">Invoices sent</span><span class="block text-sm text-ink-2">Last six months</span></figcaption><div class="mt-4"><BarChart values={[18, 22, 19, 27, 24, 31]} labels={['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct']} label="Invoices sent per month, May to October 2026. October: 31, the most in six months." /></div></figure>
  <figure><figcaption><span class="block font-bold">Where it stands</span><span class="block text-sm text-ink-2">By status, this quarter</span></figcaption>
    <div class="mt-4 flex items-center gap-5"><div class="w-[132px] shrink-0"><StatusDonut /></div>
    <StatusList class="grid gap-2 text-sm" /></div></figure>
  <figure><figcaption><span class="block font-bold">In a readout</span><span class="block text-sm text-ink-2">A sparkline on LCD glass</span></figcaption>
    <div class="lcd mt-4 px-5 py-4"><p class="text-[11px] tracking-[0.12em] uppercase text-lcd-dim">Revenue · 12 mo</p><p class="text-2xl font-semibold mt-1">$44,900</p><div class="mt-3"><Sparkline values={REV} /></div></div></figure>
</div>
