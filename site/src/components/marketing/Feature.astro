---
interface Props {
  title: string;
  body: string;
  flip?: boolean;
}
const { title, body, flip = false } = Astro.props;
---
<div class="grid gap-8 md:gap-14 md:grid-cols-2 items-center py-12 border-t border-[color:var(--k-seam)]">
  <div class={flip ? 'md:order-2' : ''}><h3 class="text-[26px] md:text-[30px] font-bold tracking-[-0.015em] text-balance">{title}</h3><p class="text-ink-2 text-lg mt-3 max-w-[46ch] text-pretty">{body}</p></div>
  <div class="rounded-[22px] seam p-6 md:p-8"><slot /></div>
</div>
