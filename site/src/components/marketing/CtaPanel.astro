---
interface Props {
  title: string;
  text: string;
  secondary: { label: string; href: string };
}
const { title, text, secondary } = Astro.props;
---
<section class="max-w-[1200px] mx-auto px-4 md:px-8 py-16 md:py-20">
  <div class="panel !px-6 !py-10 md:!px-12 md:!py-14 flex flex-wrap items-center justify-between gap-8">
    <div><h2 class="text-[32px] md:text-[40px] font-bold tracking-[-0.02em] text-balance max-w-[18ch]">{title}</h2><p class="text-ink-2 text-lg mt-3">{text}</p></div>
    <div class="flex flex-wrap gap-3"><a class="btn btn-signal btn-lg" href="sign-in.html">Start free</a><a class="btn btn-lg" href={secondary.href}>{secondary.label}</a></div>
  </div>
</section>
