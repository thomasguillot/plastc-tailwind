---
import Donut from './Donut.astro';
import { STATUS_SHARE, STATUS_SHARE_LABEL } from '../../data/app';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---
<div class={`share flex flex-wrap items-center gap-6 ${cls}`} data-share>
  <div class="w-[140px] shrink-0 [[data-hl='0']_&_.chart-seg:not([data-k='0'])]:opacity-35 [[data-hl='1']_&_.chart-seg:not([data-k='1'])]:opacity-35 [[data-hl='2']_&_.chart-seg:not([data-k='2'])]:opacity-35 [[data-hl='3']_&_.chart-seg:not([data-k='3'])]:opacity-35"><Donut segments={STATUS_SHARE} total="$63.8k" caption="invoiced" label={STATUS_SHARE_LABEL} /></div>
  <ul class="grid gap-2 text-sm min-w-[150px] flex-1" aria-label="Share by status">{STATUS_SHARE.map(({ name, value, lamp }, k) => <li data-k={k} tabindex="0" class="flex items-center justify-between gap-4 rounded-md outline-offset-4 [[data-hl='0']_&:not([data-k='0'])]:opacity-35 [[data-hl='1']_&:not([data-k='1'])]:opacity-35 [[data-hl='2']_&:not([data-k='2'])]:opacity-35 [[data-hl='3']_&:not([data-k='3'])]:opacity-35"><span class={`badge ${lamp}`}>{name}</span><span class="tabular-nums text-ink-2">{value}%</span></li>)}</ul>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
    const set = (k?: string) => (k === undefined ? root.removeAttribute('data-hl') : root.setAttribute('data-hl', k));
    root.querySelectorAll<HTMLElement>('li[data-k]').forEach((li) => {
      const k = li.dataset.k;
      li.addEventListener('pointerenter', () => set(k));
      li.addEventListener('pointerleave', () => set());
      li.addEventListener('focus', () => set(k));
      li.addEventListener('blur', () => set());
    });
  });
</script>
