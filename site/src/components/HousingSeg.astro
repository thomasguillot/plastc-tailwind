---
import Icon from './Icon.astro';
---
<div class="seg" role="group" aria-label="Appearance">
  <button type="button" class="!px-3" data-set-housing="light" aria-pressed="true" aria-label="Light"><Icon name="sun" class="w-4 h-4" /></button>
  <button type="button" class="!px-3" data-set-housing="dark" aria-pressed="false" aria-label="Dark"><Icon name="moon" class="w-4 h-4" /></button>
</div>
