---
import AppShell from '../../layouts/AppShell.astro';
import Icon from '../../components/Icon.astro';
import FilterToolbar from '../../components/app/FilterToolbar.astro';
import FilterEmpty from '../../components/app/FilterEmpty.astro';
import RowActions from '../../components/app/RowActions.astro';
import { PRODUCTS, money } from '../../data/app';

const active = PRODUCTS.filter((p) => p.group === 'active').length;
---
<AppShell title="Products · Plastc" active="products" heading="Products" sub="What you bill for, ready to drop into an invoice.">
<Fragment slot="actions"><button class="btn btn-signal" data-open-dialog="add-product"><Icon name="plus" sw="2.2" />Add product</button></Fragment>
<FilterToolbar table="prod-table" placeholder="Search products" segments={[{ key: 'active', label: 'Active', count: active }, { key: 'archived', label: 'Archived', count: PRODUCTS.length - active }]} />
<section class="panel !p-0">
  <div class="table-scroll px-2 pt-1"><table class="ktable" id="prod-table">
    <thead><tr><th>Name</th><th class="hidden sm:table-cell">Unit</th><th class="num">Price</th><th class="hidden md:table-cell num">On invoices</th><th class="w-12"><span class="sr-only">Actions</span></th></tr></thead>
    <tbody>{PRODUCTS.map((p, n) => {
      const archived = p.group === 'archived';
      return <tr data-group={p.group} hidden={archived}><td class="font-semibold">{p.name}</td><td class="hidden sm:table-cell"><span class="tag">{p.unit}</span></td><td class="num">{money(p.price)}</td><td class="hidden md:table-cell num">{p.used}</td><td class="w-12"><RowActions id={`pm${n}`} label={p.name}><button type="button" data-open-dialog="add-product"><Icon name="file" />Edit</button><button type="button" data-toast={`${p.name} duplicated`}><Icon name="copy" />Duplicate</button><hr><button type="button" data-toast={`${p.name} ${archived ? 'restored' : 'archived'}`}><Icon name="box" />{archived ? 'Restore' : 'Archive'}</button></RowActions></td></tr>;
    })}</tbody>
  </table></div>
  <FilterEmpty table="prod-table" unit="Matches" />
</section>
<dialog class="dialog" id="add-product" aria-labelledby="ap-h">
  <form method="dialog" class="grid gap-5" data-toast-on-submit="Product saved">
    <div class="flex items-start justify-between gap-4"><div><h2 id="ap-h" class="text-lg font-bold">Product</h2><p class="text-sm text-ink-2 mt-1">Something you bill for. Add it to any invoice as a line item.</p></div><button type="button" class="btn btn-quiet btn-sm btn-icon" data-close-dialog aria-label="Close"><Icon name="x" /></button></div>
    <div><label class="label" for="ap-n">Name</label><input id="ap-n" class="field" autofocus placeholder="Design day"></div>
    <div class="grid grid-cols-2 gap-4"><div><label class="label" for="ap-u">Unit</label><select id="ap-u" class="field field-select"><option>Hour</option><option selected>Day</option><option>Project</option><option>Item</option><option>Month</option></select></div>
    <div><label class="label" for="ap-p">Price</label><div class="input-group"><span class="input-affix">$</span><input id="ap-p" inputmode="decimal" placeholder="0.00"></div></div></div>
    <div class="flex justify-end gap-3 pt-1"><button type="button" class="btn" data-close-dialog>Cancel</button><button class="btn btn-signal" value="ok">Save product</button></div>
  </form>
</dialog>
</AppShell>
