---
import AppShell from '../../layouts/AppShell.astro';
import Icon from '../../components/Icon.astro';
import FilterToolbar from '../../components/app/FilterToolbar.astro';
import FilterEmpty from '../../components/app/FilterEmpty.astro';
import RowActions from '../../components/app/RowActions.astro';
import { CLIENTS, money } from '../../data/app';

const owes = CLIENTS.filter((c) => c.group.includes('owes')).length;
const overdue = CLIENTS.filter((c) => c.group.includes('overdue')).length;
---
<AppShell title="Customers · Plastc" active="customers" heading="Customers" sub="Everyone you invoice, and what each of them owes.">
<Fragment slot="actions"><button class="btn" data-toast="Import is not part of this demo"><Icon name="down" />Import</button><button class="btn btn-signal" data-open-dialog="add-customer"><Icon name="plus" sw="2.2" />Add customer</button></Fragment>
<FilterToolbar table="cust-table" placeholder="Search by name or email" segments={[{ key: 'all', label: 'All', count: CLIENTS.length }, { key: 'owes', label: 'Owes money', count: owes }, { key: 'overdue', label: 'Overdue', count: overdue }, { key: 'paid', label: 'Paid up', count: CLIENTS.length - owes }]} />
<section class="panel !p-0">
  <div class="table-scroll px-2 pt-1"><table class="ktable" id="cust-table">
    <thead><tr><th>Customer</th><th class="hidden md:table-cell num">Invoices</th><th class="num">Owes</th><th class="hidden md:table-cell num">Billed this year</th><th class="hidden md:table-cell">Last invoice</th><th class="w-12"><span class="sr-only">Actions</span></th></tr></thead>
    <tbody>{CLIENTS.map((c, n) => <tr data-group={c.group}><td><div class="flex items-center gap-3"><span class="avatar !w-8 !h-8 !text-[11px]">{c.initials}</span><div class="min-w-0"><p class="font-semibold">{c.name}</p><p class="text-ink-2 text-[13px]">{c.email}</p></div></div></td><td class="hidden md:table-cell num">{c.count}</td><td class="num">{!c.owed ? <span class="text-ink-2">$0.00</span> : c.group.includes('overdue') ? <div class="flex flex-col items-end gap-1"><span class="text-danger font-bold">{money(c.owed)}</span><span class="badge lamp-danger !text-[13px] !font-semibold !text-ink-2">Overdue</span></div> : <span class="font-semibold">{money(c.owed)}</span>}</td><td class="hidden md:table-cell num">{money(c.billed)}</td><td class="hidden md:table-cell text-ink-2 whitespace-nowrap">{c.last}</td><td class="w-12"><RowActions id={`cm${n}`} label={c.name}><button type="button" data-open-dialog="new-invoice"><Icon name="plus" />New invoice</button><button type="button" data-toast={`Statement sent to ${c.email}`}><Icon name="send" />Send statement</button><hr><button type="button" data-toast={`${c.name} archived`}><Icon name="box" />Archive</button></RowActions></td></tr>)}</tbody>
  </table></div>
  <FilterEmpty table="cust-table" unit="Matches" />
  <nav class="pager px-5 sm:px-6 py-4 border-t border-[color:var(--k-seam)]" aria-label="Pagination">
    <button class="btn btn-sm" disabled><Icon name="left" />Previous</button>
    <p class="pager-status" data-count-for="cust-table">Showing all {CLIENTS.length} customers</p>
    <button class="btn btn-sm" disabled>Next<Icon name="right" /></button>
  </nav>
</section>
<dialog class="dialog" id="add-customer" aria-labelledby="ac-h">
  <form method="dialog" class="grid gap-5" data-toast-on-submit="Customer added">
    <div class="flex items-start justify-between gap-4"><div><h2 id="ac-h" class="text-lg font-bold">Add customer</h2><p class="text-sm text-ink-2 mt-1">Invoices and statements go to this address.</p></div><button type="button" class="btn btn-quiet btn-sm btn-icon" data-close-dialog aria-label="Close"><Icon name="x" /></button></div>
    <div><label class="label" for="ac-n">Name</label><input id="ac-n" class="field" autocomplete="organization" autofocus></div>
    <div><label class="label" for="ac-e">Billing email</label><input id="ac-e" class="field" type="email" autocomplete="email"></div>
    <div class="flex justify-end gap-3 pt-1"><button type="button" class="btn" data-close-dialog>Cancel</button><button class="btn btn-signal" value="ok">Add customer</button></div>
  </form>
</dialog>
</AppShell>
