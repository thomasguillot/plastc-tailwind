---
import Base from '../layouts/Base.astro';
import SkipLink from '../components/SkipLink.astro';
import Icon from '../components/Icon.astro';
import Wordmark from '../components/Wordmark.astro';
import HousingSeg from '../components/HousingSeg.astro';
import CommandMenu, { type CommandGroup } from '../components/CommandMenu.astro';
import ShowcaseGroup from '../components/showcase/ShowcaseGroup.astro';
import Spec from '../components/showcase/Spec.astro';
import PreviewCard from '../components/showcase/PreviewCard.astro';
import ScreenViewer from '../components/showcase/ScreenViewer.astro';
import Buttons from '../components/showcase/examples/Buttons.astro';
import Inputs from '../components/showcase/examples/Inputs.astro';
import InputGroups from '../components/showcase/examples/InputGroups.astro';
import Status from '../components/showcase/examples/Status.astro';
import Combobox from '../components/showcase/examples/Combobox.astro';
import Selection from '../components/showcase/examples/Selection.astro';
import EmptyStates from '../components/showcase/examples/EmptyStates.astro';
import Overlays from '../components/showcase/examples/Overlays.astro';
import Progress from '../components/showcase/examples/Progress.astro';
import FileUpload from '../components/showcase/examples/FileUpload.astro';
import Tabs from '../components/showcase/examples/Tabs.astro';
import Breadcrumbs from '../components/showcase/examples/Breadcrumbs.astro';
import Accordion from '../components/showcase/examples/Accordion.astro';
import AvatarTimeline from '../components/showcase/examples/AvatarTimeline.astro';
import Charts from '../components/showcase/examples/Charts.astro';
import NavigationData from '../components/showcase/examples/NavigationData.astro';
import { GITHUB_SVG } from '../lib/icons';
import { HOUSING_COMMAND } from '../data/commands';
import { CSS_KB, CSS_ON_GITHUB, DESCRIPTION, HOME_TITLE, IMPORT_LINE, REPO, SITE, VERSION } from '../data/site';
import { DEPTH_TOKENS, GROUPS, MARKETING_SCREENS, SCALE, SCREENS } from '../data/showcase';

const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const screen = (key: string, text: string, icon: CommandGroup['items'][number]['icon'], hash = '') => ({ icon, text, attrs: { href: `screens/${key}.html${hash}`, 'data-open-screen': `${key}${hash}` } });
const commandExample: CommandGroup[] = [
  { label: 'Go to', items: [{ icon: 'home', text: 'Dashboard', attrs: { href: 'dashboard.html' } }, { icon: 'file', text: 'Invoices', attrs: { href: 'invoices.html' } }] },
  { label: 'Actions', items: [{ icon: 'plus', text: 'New invoice', attrs: { 'data-command': 'new-invoice' }, kbd: 'N' }] },
];
const commands: CommandGroup[] = [
  { label: 'Screens', items: [screen('dashboard', 'Dashboard', 'home'), screen('invoices', 'Invoices', 'file'), screen('settings', 'Settings', 'cog'), screen('customers', 'Customers', 'users'), screen('reports', 'Reports', 'chart'), screen('products', 'Products', 'box')] },
  {
    label: 'Marketing pages',
    items: [
      screen('landing', 'Landing page', 'send'),
      screen('pricing', 'Pricing', 'tag'),
      screen('blog', 'Blog', 'book'),
      screen('article', 'Article', 'article'),
      screen('about', 'About', 'info'),
      screen('about', 'Careers', 'briefcase', '#careers'),
      screen('contact', 'Contact', 'mail'),
      screen('sign-in', 'Sign in', 'key'),
      screen('404', '404', 'compass'),
    ],
  },
  {
    label: 'On this page',
    items: [
      ['depth', 'Depth'],
      ['components', 'Components'],
      ['screens', 'App screens'],
      ['marketing', 'Marketing sections'],
      ['tokens', 'Tokens'],
      ['install', 'Install'],
    ].map(([k, label]) => ({ icon: 'hash' as const, text: label, attrs: { href: `#${k}` } })),
  },
  {
    label: 'Actions',
    items: [
      HOUSING_COMMAND,
      { icon: 'down', text: 'Download plastc.css', attrs: { href: 'plastc.css', download: true } },
      { icon: 'copy', text: 'Copy the import line', attrs: { 'data-copy': IMPORT_LINE } },
      { icon: 'external', text: 'Source on GitHub', attrs: { href: REPO } },
    ],
  },
  { label: 'Components', items: Object.values(GROUPS).map(({ id, title, classes }) => ({ icon: 'grid' as const, text: escapeHtml(title), attrs: { href: `#${id}`, 'data-keywords': [...classes.matchAll(/[.]([a-z][a-z0-9-]*)/g)].map((m) => m[1]).join(' ') } })) },
];
const fontLink = '<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=Geist+Mono:wght@400..600&display=swap" rel="stylesheet">';
const colors = ['success', 'warning', 'error'].flatMap((c) => [50, 300, 600].map((n) => ({ c, n })));
---
<Base title={HOME_TITLE} description={DESCRIPTION}>
<Fragment slot="head"><link rel="canonical" href={`${SITE}/`}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Plastc">
<meta property="og:title" content={HOME_TITLE}>
<meta property="og:description" content={DESCRIPTION}>
<meta property="og:url" content={`${SITE}/`}>
</Fragment>
<SkipLink />
<header class="max-w-[1240px] mx-auto px-4 md:px-8 pt-6 pb-2 md:pb-6 flex flex-wrap items-center gap-x-6 gap-y-3">
  <Wordmark href="#top" root="" />
  <nav class="order-3 md:order-none w-full md:w-auto flex flex-wrap gap-1 -mx-1 md:mx-0 md:ml-4" aria-label="Sections"><a class="btn btn-quiet btn-sm" href="#depth">Depth</a><a class="btn btn-quiet btn-sm" href="#components">Components</a><a class="btn btn-quiet btn-sm" href="#screens">Screens</a><a class="btn btn-quiet btn-sm" href="#install">Install</a></nav>
  <a class="btn btn-quiet btn-sm ml-auto" href={REPO}><Fragment set:html={GITHUB_SVG} /><span class="sr-only sm:not-sr-only">GitHub</span></a>
  <HousingSeg />
</header>

<main id="main">
<section id="top" class="max-w-[1240px] mx-auto px-4 md:px-8 pt-8 pb-12 md:pt-16 md:pb-24 grid gap-12 lg:grid-cols-[1.25fr_1fr] items-center">
  <div>
    <h1 class="display text-[52px] sm:text-[76px] lg:text-[96px]">Every button a real button.</h1>
    <p class="text-lg text-ink-2 max-w-[46ch] mt-7 leading-relaxed">Plastc is a neumorphic UI library for Tailwind v4, with components, app screens and tokens. Depth goes only where your hand expects it. Parts you press stand up, parts that hold input sit in, and everything else stays flush and quiet.</p>
    <div class="flex flex-wrap gap-3 mt-9"><a class="btn btn-signal btn-xl" href="plastc.css" download><Icon name="down" />Get the CSS</a><a class="btn btn-xl" href="screens/dashboard.html" data-open-screen="dashboard">Open the dashboard</a></div>
    <p class="text-sm text-ink-2 mt-4 tabular-nums">plastc.css · v{VERSION} · {CSS_KB} KB · MIT-Licensed</p>
  </div>

  <div class="relative mx-auto w-full max-w-[400px]">
    <div class="rounded-[34px] p-6 sm:p-7 bg-[image:var(--k-cast)] shadow-[var(--k-raised)]">
      <div class="lcd px-5 py-4 flex items-end justify-between">
        <div><p class="text-[11px] tracking-[0.12em] uppercase text-lcd-dim">Depth</p><p class="text-[40px] font-semibold leading-none mt-1" data-depth-readout>1.0</p></div>
        <div class="text-right"><p class="text-[11px] tracking-[0.12em] uppercase text-lcd-dim">Housing</p><p class="text-lg font-semibold mt-1 uppercase" data-housing-readout>Light</p></div>
      </div>
      <p class="engraved mt-7 mb-3" id="dk">Depth</p>
      <div class="grid grid-cols-3 gap-4" role="group" aria-labelledby="dk">
        <button class="key text-sm" data-set-depth="0.5" aria-pressed="false">Soft</button>
        <button class="key text-sm" data-set-depth="1" aria-pressed="true">Normal</button>
        <button class="key text-sm" data-set-depth="1.7" aria-pressed="false">Deep</button>
      </div>
      <p class="engraved mt-6 mb-3" id="hk">Housing</p>
      <div class="grid grid-cols-3 gap-4" role="group" aria-labelledby="hk">
        <button class="key text-[13px]" data-set-housing="light" aria-pressed="true">Light</button>
        <button class="key text-[13px]" data-set-housing="dark" aria-pressed="false">Dark</button>
        <button class="key text-[13px]" data-reset>Reset</button>
      </div>
    </div>
  </div>
</section>

<section id="depth" class="max-w-[1240px] mx-auto px-4 md:px-8 py-16 md:py-20">
  <h2 class="display text-[40px] md:text-[56px] max-w-[14ch]">Four depths. One reason each.</h2>
  <p class="text-ink-2 text-lg max-w-[56ch] mt-5">Most neumorphism extrudes everything, so nothing reads as touchable. Plastc gives each depth a job, and the job decides the shadow.</p>
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 mt-12">
    <Spec name="Plane" classes=".panel  .seam" rule="The housing and every layout container. Flush, separated by a moulded parting line."><div class="panel w-full max-w-[220px] !p-4 text-left"><p class="text-[13px] font-bold">INV-0193</p><div class="flex justify-between mt-2 text-[13px]"><span class="badge lamp-ok">Paid</span><span class="font-semibold tabular-nums">$4,820.00</span></div></div></Spec>
    <Spec name="Raised" classes=".btn  .key  .raised" rule="Only parts you press. Lit from the top, with a contact shadow. Pressing sets them flush."><button class="btn btn-lg" type="button">Press me</button></Spec>
    <Spec name="Recessed" classes=".field  .lcd  .recessed" rule="Only parts that hold input or output: fields, tracks, wells, readouts."><input class="field !w-44" placeholder="Type here" aria-label="Example field"></Spec>
    <Spec name="Float" classes=".menu  .dialog  .toast" rule="Overlays only. The one level with a long shadow, because it really sits above the page."><div class="menu !min-w-0 w-40"><a href="#depth">Rename</a><a href="#depth">Duplicate</a></div></Spec>
  </div>
</section>

<section id="components" class="max-w-[1240px] mx-auto px-4 md:px-8 py-16 md:py-20">
  <div class="flex flex-wrap items-end justify-between gap-6 mb-10">
    <h2 class="display text-[40px] md:text-[56px]">Components</h2>
    <p class="text-ink-2 max-w-[44ch]">Every part below is live HTML using the classes beside it. Press, type and toggle, then view or copy the markup.</p>
  </div>
  <nav aria-label="Component groups" class="mb-8"><ul class="flex flex-wrap gap-1 -ml-3.5">{Object.values(GROUPS).map(({ id, title }) => <li><a class="btn btn-quiet btn-sm" href={`#${id}`}>{title}</a></li>)}</ul></nav>
  <div class="grid lg:grid-cols-2 gap-x-14 [&>*]:min-w-0">
    <ShowcaseGroup {...GROUPS.buttons}><Buttons /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.inputs}><Inputs /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.inputGroups}><InputGroups /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.status}><Status /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.combobox}><Combobox /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.selection}><Selection /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.empty}><EmptyStates /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.overlays}><Overlays /><Fragment slot="extra"><div class="toast" popover="manual" role="status" id="toast"><span>Invoice INV-0193 sent</span><button type="button" class="lcd-action">Undo</button></div></Fragment></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.progress}><Progress /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.upload}><FileUpload /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.tabs}><Tabs /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.command}><Breadcrumbs /><CommandMenu slot="extra" groups={commandExample} /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.accordion}><Accordion /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.timeline}><AvatarTimeline /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.charts}><Charts /></ShowcaseGroup>
    <ShowcaseGroup {...GROUPS.navigation}><NavigationData /></ShowcaseGroup>
  </div>
</section>

<section id="screens" class="max-w-[1240px] mx-auto px-4 md:px-8 py-16 md:py-20">
  <h2 class="display text-[40px] md:text-[56px]">App screens</h2>
  <p class="text-ink-2 text-lg max-w-[56ch] mt-5 mb-10">Full reference screens composed from the kit, on the same depth rules. Dense data stays flat and only the controls have depth. Try them on a phone too.</p>
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{SCREENS.map(({ key, title }) => <PreviewCard screen={key} title={title} />)}</div>
</section>

<section id="marketing" class="max-w-[1240px] mx-auto px-4 md:px-8 py-16 md:py-20">
  <h2 class="display text-[40px] md:text-[56px]">Marketing sections</h2>
  <p class="text-ink-2 text-lg max-w-[56ch] mt-5 mb-10">A small marketing site for a made-up invoicing product: landing page, pricing, blog, article, about, contact, sign-in and a 404. The product, people and copy are samples, and every page is built from the same parts.</p>
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">{MARKETING_SCREENS.map(({ key, title }) => <PreviewCard screen={key} title={title} />)}</div>
</section>

<section id="tokens" class="max-w-[1240px] mx-auto px-4 md:px-8 py-16 md:py-20">
  <h2 class="display text-[40px] md:text-[56px]">Tokens</h2>
  <div class="mt-10">
    <h3 class="engraved mb-4">Depth · four levels and the pressed state</h3>
    <div class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-5 gap-x-4 gap-y-8">{DEPTH_TOKENS.map(({ name, token, style, note, decl }) => <div class="min-w-0"><div class="rounded-[18px] seam p-5"><div class="h-20 rounded-[14px] grid place-items-center text-[13px] font-bold" style={style}>{name}</div></div><p class="font-mono text-[13px] font-bold mt-3">{token}</p><p class="text-sm text-ink-2 mt-1">{note}</p><button class="btn btn-quiet btn-sm mt-2" data-copy={decl} aria-label={`Copy ${decl}`}><Icon name="copy" />Copy</button></div>)}</div>
    <p class="text-sm text-ink-2 max-w-[64ch] mt-6"><code class="font-mono">--k-depth</code> scales every offset and blur: <code class="font-mono">.depth-soft</code> sets it to 0.5 and <code class="font-mono">.depth-deep</code> to 1.7, on any region.</p>
  </div>
  <div class="grid gap-10 lg:grid-cols-2 mt-10">
    <div>
      <h3 class="engraved mb-4">Gray · warm, tuned to the light housing</h3>
      <div class="grid grid-cols-6 sm:grid-cols-12 gap-1.5">{SCALE.map((n) => <div class="min-w-0"><div class={`h-12 rounded-md seam bg-gray-${n}`} title={`gray-${n}`}></div><p class="font-mono text-[11px] text-ink-2 mt-1.5 text-center">{n}</p></div>)}</div>
      <h3 class="engraved mt-7 mb-4">Brand · signal orange</h3>
      <div class="grid grid-cols-6 sm:grid-cols-12 gap-1.5">{SCALE.map((n) => <div class="min-w-0"><div class={`h-12 rounded-md seam bg-brand-${n}`} title={`brand-${n}`}></div><p class="font-mono text-[11px] text-ink-2 mt-1.5 text-center">{n}</p></div>)}</div>
      <h3 class="engraved mt-7 mb-4">Success · Warning · Error</h3>
      <div class="grid grid-cols-6 gap-1.5">{colors.map(({ c, n }) => <div class="min-w-0"><div class={`h-10 rounded-md seam bg-${c}-${n}`} title={`${c}-${n}`}></div><p class="font-mono text-[11px] text-ink-2 mt-1.5 text-center">{n}</p></div>)}</div>
    </div>
    <div>
      <h3 class="engraved mb-4">Type · Geist and Geist Mono</h3>
      <p class="display text-[48px] sm:text-[56px]">Display 700</p>
      <p class="text-[30px] font-bold tracking-[-0.015em] mt-4">Heading, 30 / bold</p>
      <p class="text-base mt-3 max-w-[52ch]">Body, 16 / regular. Geist throughout, sentence case everywhere. Display sizes tighten to −0.04em; UI text stays at default tracking.</p>
      <p class="font-mono text-sm mt-3">Readouts · Geist Mono · $48,210.00</p>
      <h3 class="engraved mt-8 mb-4">Motion</h3>
      <p class="text-sm text-ink-2 max-w-[52ch]">Press 80ms down, 160ms up. Toggles 200ms. Menus 180ms in, 120ms out. Dialogs 240ms in, 160ms out. One curve: <code class="font-mono">cubic-bezier(0.23, 1, 0.32, 1)</code>. Nothing moves on scroll.</p>
    </div>
  </div>
</section>

<section id="install" class="max-w-[1240px] mx-auto px-4 md:px-8 py-16 md:py-24">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] items-start [&>*]:min-w-0">
    <div>
      <h2 class="display text-[40px] md:text-[56px]">Install</h2>
      <p class="text-ink-2 text-lg max-w-[44ch] mt-5">Plastc isn’t on npm yet. It’s one CSS file you add next to your Tailwind v4 entry stylesheet.</p>
      <div class="flex flex-wrap gap-3 mt-8"><a class="btn btn-signal btn-lg" href="plastc.css" download><Icon name="down" />Download plastc.css</a><button type="button" class="btn btn-lg" data-copy={IMPORT_LINE}><Icon name="copy" />Copy the import</button></div>
      <p class="text-sm text-ink-2 mt-4 tabular-nums">v{VERSION} · {CSS_KB} KB · MIT-Licensed</p>
    </div>
    <ol class="grid grid-cols-1 gap-6 list-none p-0 m-0">
      <li><p class="font-bold mb-2">Add <code class="font-mono text-[14px]">plastc.css</code> to your project</p><p class="text-sm text-ink-2"><a class="text-ink underline" href="plastc.css" download>Download it</a>, or copy <a class="text-ink underline" href={CSS_ON_GITHUB}><code class="font-mono">src/plastc.css</code> on GitHub</a>. It holds the tokens, depth recipes and every component class.</p></li>
      <li><p class="font-bold mb-2">Import it after Tailwind</p>
        <pre class="code min-w-0">{IMPORT_LINE}</pre></li>
      <li><p class="font-bold mb-2">Load Geist</p>
        <div class="flex items-start gap-3"><pre class="code flex-1 min-w-0">{fontLink}</pre><button class="btn btn-sm shrink-0 mt-1.5" data-copy={fontLink}><Icon name="copy" />Copy</button></div></li>
      <li><p class="font-bold mb-2">Pick a housing</p><p class="text-sm text-ink-2">Light is the default. Add <code class="font-mono">data-housing="dark"</code> to <code class="font-mono">&lt;html&gt;</code> (or any section) for dark.</p></li>
    </ol>
  </div>
</section>
</main>
<ScreenViewer />
<CommandMenu groups={commands} />

<footer class="max-w-[1240px] mx-auto px-4 md:px-8 py-10 border-t border-[color:var(--k-seam)] flex flex-wrap gap-4 justify-between items-center text-sm text-ink-2">
  <p>© 2026 Thomas Guillot · MIT-Licensed · <a class="text-ink underline" href={REPO}>Source on GitHub</a></p><a href="#top" class="btn btn-quiet btn-sm">Back to top</a>
</footer>
</Base>
