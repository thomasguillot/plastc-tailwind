---
import Base from '../layouts/Base.astro';
import SkipLink from '../components/SkipLink.astro';
import CommandMenu, { type CommandItem } from '../components/CommandMenu.astro';
import ScreenViewer from '../components/showcase/ScreenViewer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/home/Hero.astro';
import Anatomy from '../components/home/Anatomy.astro';
import LightDark from '../components/home/LightDark.astro';
import Contrast from '../components/home/Contrast.astro';
import Install from '../components/home/Install.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteCommands } from '../data/commands';
import { HOME_DESCRIPTION } from '../data/home';
import { HOME_TITLE, SITE } from '../data/site';

const onThisPage: CommandItem[] = [
  ['anatomy', 'What one screen is made of'],
  ['themes', 'Light and dark'],
  ['contrast', 'Contrast, measured'],
  ['install', 'Add it to your project'],
].map(([k, label]) => ({ icon: 'hash' as const, text: label, attrs: { href: `#${k}` } }));
---
<Base title={HOME_TITLE} description={HOME_DESCRIPTION} root="/">
<Fragment slot="head"><link rel="canonical" href={`${SITE}/`}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Plastc">
<meta property="og:title" content={HOME_TITLE}>
<meta property="og:description" content={HOME_DESCRIPTION}>
<meta property="og:url" content={`${SITE}/`}>
</Fragment>
<SkipLink />
<SiteHeader path="/" />
<main id="main">
<Hero />
<Anatomy />
<LightDark />
<Contrast />
<Install />
</main>
<SiteFooter />
<ScreenViewer />
<CommandMenu groups={siteCommands(onThisPage)} />
</Base>

<style is:global>
  html{scroll-behavior:smooth}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
