---
import Components from '../../layouts/Components.astro';
import { PAGES } from '../../components/components/pages';

const titles = PAGES.map((p) => p.title.toLowerCase());
const description = `Plastc components for Tailwind CSS v4, in ${PAGES.length} groups: ${titles.slice(0, -1).join(', ')} and ${titles.at(-1)}.`;
---
<Components title="Components · Plastc" description={description}>
  <h1 class="display text-[44px] sm:text-[56px] md:text-[64px]">Components</h1>
  <p class="text-lg text-ink-2 max-w-[56ch] mt-5 leading-relaxed">Pick a group to try its parts, copy their HTML and compare the states each one supports.</p>
  <ul class="grid gap-4 sm:grid-cols-2 mt-10 list-none p-0">
    {PAGES.map((p) => (
      <li>
        <a class="flex flex-col gap-3 h-full p-5 rounded-2xl text-ink no-underline bg-[var(--k-housing)] shadow-[var(--k-raised)] transition-[box-shadow,translate] duration-[180ms] hover:shadow-[var(--k-raised-hover)] active:translate-y-px active:shadow-[var(--k-pressed)] focus-visible:outline-2 focus-visible:outline-[var(--k-focus)] focus-visible:outline-offset-2" href={`/components/${p.slug}/`}>
          <h2 class="text-[19px] font-bold">{p.title}</h2>
          <p class="text-sm text-ink-2">{p.summary}</p>
          <code class="font-mono text-[11px] text-ink-2 break-words mt-auto">{p.classes}</code>
        </a>
      </li>
    ))}
  </ul>
</Components>
